{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/run-session.schema.json",
  "title": "Run session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "benchmark",
    "execution_config_id",
    "state",
    "started_at"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "benchmark": {
      "$ref": "benchmark-reference.schema.json"
    },
    "execution_config_id": {
      "type": "string",
      "pattern": "^config_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": {
      "enum": [
        "created",
        "running",
        "completed",
        "failed",
        "cancelled",
        "abandoned"
      ]
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "ended_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
