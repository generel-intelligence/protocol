{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "artifact_id",
    "role",
    "media_type",
    "byte_size",
    "digest"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/artifactId"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[^\\s/]+/[^\\s/]+$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    }
  }
}
