{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/final-run-manifest.schema.json",
  "title": "Final run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "run_outcome",
    "evidence_status",
    "finalized_at",
    "chunks",
    "artifacts",
    "objective_result"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "run_outcome": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "abandoned"
      ]
    },
    "evidence_status": {
      "const": "complete"
    },
    "finalized_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "event-chunk.schema.json"
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      }
    },
    "objective_result": {
      "$ref": "common.schema.json#/$defs/artifactReference"
    }
  }
}
