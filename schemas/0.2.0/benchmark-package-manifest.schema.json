{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.2.0/benchmark-package-manifest.schema.json",
  "title": "Benchmark package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "format_version",
    "suite",
    "tasks",
    "environment",
    "licenses",
    "files"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.2.0"
    },
    "format_version": {
      "const": "0.1.0"
    },
    "suite": {
      "$ref": "#/$defs/suite"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/license"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "packageSemver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}($|/)"
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest_path", "manifest_digest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^suite_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "version": {
          "$ref": "#/$defs/packageSemver"
        },
        "manifest_path": {
          "$ref": "#/$defs/path"
        },
        "manifest_digest": {
          "$ref": "#/$defs/packageSha256"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest_path", "manifest_digest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^task_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "version": {
          "$ref": "#/$defs/packageSemver"
        },
        "manifest_path": {
          "$ref": "#/$defs/path"
        },
        "manifest_digest": {
          "$ref": "#/$defs/packageSha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "platform"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+@sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9]+/[a-z0-9]+$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "digest": {
          "$ref": "#/$defs/packageSha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "byte_size", "license_id"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "digest": {
          "$ref": "#/$defs/packageSha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "license_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    }
  }
}
