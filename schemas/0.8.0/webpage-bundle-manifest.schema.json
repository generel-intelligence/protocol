{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.8.0/webpage-bundle-manifest.schema.json",
  "title": "Webpage bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "profile",
    "source_root",
    "entrypoint",
    "files",
    "total_byte_size"
  ],
  "properties": {
    "protocol_version": { "const": "0.8.0" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "webpage-bundle" },
        "version": { "const": "0.1.0" }
      }
    },
    "source_root": {
      "type": "string",
      "minLength": 11,
      "maxLength": 1035,
      "pattern": "^workspace:/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "entrypoint": { "$ref": "#/$defs/webpageBundlePath" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/file" }
    },
    "total_byte_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "byte_size", "artifact"],
      "properties": {
        "path": { "$ref": "#/$defs/webpageBundlePath" },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "digest"],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^artifact_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "webpageBundlePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": { "pattern": "(^|/)\\.{1,2}($|/)" }
    }
  }
}
