{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.7.0/artifact-output-manifest.schema.json",
  "title": "Artifact output manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "outputs"],
  "properties": {
    "protocol_version": {
      "const": "0.7.0"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "media_type", "maximum_bytes"],
        "properties": {
          "path": {
            "$ref": "#/$defs/artifactOutputPath"
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "media_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
          },
          "maximum_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          }
        }
      }
    }
  },
  "$defs": {
    "artifactOutputPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}($|/)"
      }
    }
  }
}
