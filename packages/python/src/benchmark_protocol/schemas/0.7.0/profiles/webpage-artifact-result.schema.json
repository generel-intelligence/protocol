{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.7.0/profiles/webpage-artifact-result.schema.json",
  "title": "Webpage artifact result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "profile", "suite", "task", "evaluator", "execution_contract", "outcome"],
  "properties": {
    "protocol_version": { "const": "0.7.0" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "webpage-artifact-result" },
        "version": { "const": "0.1.0" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "package_digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^suite_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "version": { "$ref": "#/$defs/webpageResultSemver" },
        "package_digest": { "$ref": "#/$defs/webpageResultSha256" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^task_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "version": { "$ref": "#/$defs/webpageResultSemver" }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "image_digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^evaluator_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "version": { "$ref": "#/$defs/webpageResultSemver" },
        "image_digest": { "$ref": "#/$defs/webpageResultSha256" }
      }
    },
    "execution_contract": { "const": "workspace-snapshot/0.1.0" },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "groups", "passed_count", "total_count", "passed"],
          "properties": {
            "status": { "const": "completed" },
            "groups": {
              "type": "object",
              "additionalProperties": false,
              "required": ["deliverable", "html_document", "self_contained", "requested_surface"],
              "properties": {
                "deliverable": { "type": "boolean" },
                "html_document": { "type": "boolean" },
                "self_contained": { "type": "boolean" },
                "requested_surface": { "type": "boolean" }
              }
            },
            "passed_count": { "type": "integer", "minimum": 0, "maximum": 4 },
            "total_count": { "const": 4 },
            "passed": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_code"],
          "properties": {
            "status": { "const": "error" },
            "error_code": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "not_run" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      ]
    }
  },
  "$defs": {
    "webpageResultSemver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "webpageResultSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
