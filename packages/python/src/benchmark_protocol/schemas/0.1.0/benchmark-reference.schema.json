{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/benchmark-reference.schema.json",
  "title": "Benchmark reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "profile",
    "benchmark_family",
    "dataset",
    "task",
    "evaluator"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "profile": {
      "$ref": "common.schema.json#/$defs/profileReference"
    },
    "benchmark_family": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "revision",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_id"
      ],
      "properties": {
        "upstream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "config_digest"
      ],
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "config_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "image_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
