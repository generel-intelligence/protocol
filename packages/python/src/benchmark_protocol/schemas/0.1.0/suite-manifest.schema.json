{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/suite-manifest.schema.json",
  "title": "Suite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "suite_id",
    "suite_version",
    "license",
    "task_ids",
    "assets"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^suite_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/taskId"
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      }
    }
  }
}
