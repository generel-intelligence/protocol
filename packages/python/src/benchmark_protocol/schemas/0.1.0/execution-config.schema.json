{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/execution-config.schema.json",
  "title": "Execution configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "config_id",
    "model",
    "agent",
    "environment"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "config_id": {
      "type": "string",
      "pattern": "^config_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "parameters_digest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parameters_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "config_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_digest"
      ],
      "properties": {
        "image_digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
