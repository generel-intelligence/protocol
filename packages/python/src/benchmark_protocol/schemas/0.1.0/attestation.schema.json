{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/attestation.schema.json",
  "title": "Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "attestation_id",
    "kind",
    "issuer",
    "issued_at",
    "subject_digest",
    "method",
    "evidence"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^attestation_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "enum": [
        "schema_validated",
        "source_attested",
        "upstream_verified",
        "generel_reproduced"
      ]
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "subject_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReference"
      },
      "uniqueItems": true
    }
  }
}
