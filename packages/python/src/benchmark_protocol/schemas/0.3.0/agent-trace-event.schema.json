{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.3.0/agent-trace-event.schema.json",
  "title": "Agent trace event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "sequence",
    "event_id",
    "profile",
    "producer",
    "source",
    "relationships",
    "occurred_at",
    "captured_at",
    "capture",
    "artifacts",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.3.0"
    },
    "run_id": {
      "$ref": "../0.1.0/common.schema.json#/$defs/runId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_id": {
      "type": "string",
      "pattern": "^event_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "profile": {
      "$ref": "../0.1.0/common.schema.json#/$defs/profileReference"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "relationships": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "occurred_at": {
      "$ref": "../0.1.0/common.schema.json#/$defs/timestamp"
    },
    "captured_at": {
      "$ref": "../0.1.0/common.schema.json#/$defs/timestamp"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../0.1.0/common.schema.json#/$defs/artifactReference"
      }
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/runStarted"
        },
        {
          "$ref": "#/$defs/taskStarted"
        },
        {
          "$ref": "#/$defs/taskFinished"
        },
        {
          "$ref": "#/$defs/runFinished"
        },
        {
          "$ref": "#/$defs/conversationMessage"
        },
        {
          "$ref": "#/$defs/modelRequest"
        },
        {
          "$ref": "#/$defs/modelResponseStarted"
        },
        {
          "$ref": "#/$defs/modelResponseFinished"
        },
        {
          "$ref": "#/$defs/toolFinished"
        },
        {
          "$ref": "#/$defs/workspaceCheckpoint"
        },
        {
          "$ref": "#/$defs/executionError"
        }
      ]
    }
  },
  "if": {
    "properties": {
      "payload": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "run_started",
              "task_started",
              "task_finished",
              "run_finished"
            ]
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "required": [
      "payload"
    ]
  },
  "then": {
    "properties": {
      "profile": {
        "const": {
          "id": "lifecycle",
          "version": "0.1.0"
        }
      }
    }
  },
  "else": {
    "properties": {
      "profile": {
        "const": {
          "id": "agent-trace",
          "version": "0.3.0"
        }
      }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "runner",
            "evaluator",
            "importer"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "runner",
            "harness",
            "model_gateway",
            "workspace",
            "container"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id"
      ],
      "properties": {
        "type": {
          "enum": [
            "parent",
            "responds_to",
            "caused_by",
            "checkpoint_after"
          ]
        },
        "event_id": {
          "type": "string",
          "pattern": "^event_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "../0.1.0/common.schema.json#/$defs/warning"
          }
        }
      }
    },
    "runStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "run_started"
        }
      }
    },
    "taskStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "task_id"
      ],
      "properties": {
        "type": {
          "const": "task_started"
        },
        "task_id": {
          "$ref": "../0.1.0/common.schema.json#/$defs/taskId"
        }
      }
    },
    "taskFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "task_id",
        "outcome"
      ],
      "properties": {
        "type": {
          "const": "task_finished"
        },
        "task_id": {
          "$ref": "../0.1.0/common.schema.json#/$defs/taskId"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "error"
          ]
        }
      }
    },
    "runFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "outcome"
      ],
      "properties": {
        "type": {
          "const": "run_finished"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "abandoned"
          ]
        }
      }
    },
    "conversationMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message_id",
        "role"
      ],
      "properties": {
        "type": {
          "const": "conversation_message"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        }
      }
    },
    "modelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "model_id"
      ],
      "properties": {
        "type": {
          "const": "model_request"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "modelResponseStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "status"
      ],
      "properties": {
        "type": {
          "const": "model_response_started"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      }
    },
    "modelResponseFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "outcome",
        "chunk_count"
      ],
      "properties": {
        "type": {
          "const": "model_response_finished"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "enum": [
            "completed",
            "error"
          ]
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "toolFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "call_id",
        "outcome",
        "tool_name"
      ],
      "properties": {
        "type": {
          "const": "tool_finished"
        },
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "enum": [
            "completed",
            "error"
          ]
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "workspaceCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "checkpoint_id",
        "changed"
      ],
      "properties": {
        "type": {
          "const": "workspace_checkpoint"
        },
        "checkpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "executionError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "component",
        "code"
      ],
      "properties": {
        "type": {
          "const": "execution_error"
        },
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        }
      }
    }
  }
}
