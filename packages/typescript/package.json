{
  "name": "@local/benchmark-protocol",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "schemas",
    "src/generated",
    "VERSION"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./types/*": {
      "types": "./src/generated/*.d.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
