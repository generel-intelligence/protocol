{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/0.1.0/event-chunk.schema.json",
  "title": "Event chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "ordinal",
    "sequence_range",
    "event_count",
    "digest"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_range": {
      "$ref": "common.schema.json#/$defs/sequenceRange"
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
